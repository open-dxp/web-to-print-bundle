{
    "name": "open-dxp/web-to-print-bundle",
    "license": "GPL-3.0-or-later",
    "type": "opendxp-bundle",
    "description": "OpenDxp WebToPrint Bundle",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "doctrine/dbal": "^3.6",
        "open-dxp/admin-bundle": "^1.4",
        "open-dxp/opendxp": "^1.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "gotenberg/gotenberg-php": "^2.2",
        "dompdf/dompdf": "^3.0",
        "codeception/codeception": "^5.0.3",
        "codeception/module-symfony": "^3.1.0",
        "codeception/phpunit-wrapper": "^9",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "conflict": {
        "gotenberg/gotenberg-php": "<2.2.0"
    },
    "suggest": {
        "gotenberg/gotenberg-php": "^2.2",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\WebToPrintBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\WebToPrintBundle\\Tests\\": "tests"
        },
        "files": [
            "kernel/Kernel.php"
        ]
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\WebToPrintBundle\\OpenDxpWebToPrintBundle"
            ]
        }
    }
}
